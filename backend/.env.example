# ==============================================================================
# Dayflow HRMS Environment Configuration Example
# Copy this file to .env in your root or backend directory and configure values
# ==============================================================================

# Security & JWT
SECRET_KEY=dayflow-super-secret-jwt-key-change-in-production-2025
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Defaults to SQLite locally: sqlite:///./dayflow.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dayflow_db
DATABASE_URL=sqlite:///./dayflow.db

# Redis for Distributed OTP Storage & Rate Limiting
# Optional: If not provided, Dayflow automatically falls back to in-memory store
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Email Provider Option 1: Resend (Recommended)
# Sign up at https://resend.com and paste your API key below
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# Email Provider Option 2: Mailtrap (Local Testing Sandbox)
# Sign up at https://mailtrap.io and copy your SMTP credentials below
# ------------------------------------------------------------------------------
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username_here
MAILTRAP_PASS=your_mailtrap_password_here

# ------------------------------------------------------------------------------
# AI Assistant (Google Gemini)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
